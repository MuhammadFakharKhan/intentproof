    "postconditions": [
      {"target": "deployment_reminder", "field": "starts_at", "equals": "22:00"},
      {"target": "maintenance_status", "field": "active", "equals": true}
    ],
    "forbidden_operations": ["UNLOCK"],
    "recovery": {"auto_retry_operations": ["LIGHT_ON"], "max_auto_retries": 1, "sensitive_retry_requires_approval": true},
    "verification": {"require_readback": true, "unknown_is_success": false}
  },
  "initial_state": {
    "deployment_reminder": {"starts_at": null},
    "maintenance_status": {"active": false}
  },
